<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BarberApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/barber_primary</item>
        <item name="colorPrimaryVariant">@color/barber_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/barber_accent</item>
        <item name="colorSecondaryVariant">@color/barber_accent_light</item>
        <item name="colorOnSecondary">@color/brand_on_accent</item>
        <!-- Brands the UsersSDK screens (calendar, profile, add-appointment button). -->
        <item name="usersSdkColorPrimary">@color/barber_accent</item>
        <item name="usersSdkColorOnPrimary">@color/brand_on_accent</item>
        <item name="usersSdkColorSurface">@color/barber_surface</item>
        <item name="usersSdkColorCard">@color/white</item>
        <item name="usersSdkColorOnSurface">@color/barber_primary</item>
        <item name="usersSdkCornerRadius">@dimen/brand_corner_radius</item>
        <item name="android:statusBarColor">@color/barber_primary_dark</item>
        <!-- targetSdk 35 draws edge-to-edge by default; these screens are not inset-aware yet. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
