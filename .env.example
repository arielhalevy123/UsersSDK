# Copy to .env and fill in. .env is gitignored — never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/usersdb
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Generate a fresh one:  openssl rand -base64 32
JWT_SECRET=replace_me_with_a_freshly_generated_key

# Optional
# PORT=8080                                   # hosts like Railway set this
# SEED_DEMO_DATA=true                         # demo accounts; set false on public servers
# CORS_ALLOWED_ORIGINS=http://localhost:3000  # extra browser origins, comma-separated
# JPA_SHOW_SQL=false
